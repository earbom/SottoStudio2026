rules_version = '2';

// =====================================================================
// SOTTO STUDIO - Reglas de seguridad de Firestore
// Modelo de permisos: un usuario puede tener uno o varios de
// {alumno, profesor, direccion} simultáneamente (p.ej. una directora
// que también da clase). Ver CLAUDE.md, sección de permisos.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------
    function estaAutenticado() {
      return request.auth != null;
    }

    function usuarioActual() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function tienePermiso(permiso) {
      return estaAutenticado() && permiso in usuarioActual().permisos;
    }

    function esAlumno() {
      return tienePermiso('alumno');
    }

    function esProfesor() {
      return tienePermiso('profesor');
    }

    function esDireccion() {
      return tienePermiso('direccion');
    }

    // Cuenta especial única (Edgar), fijada a mano por consola de
    // Firebase junto a los otros 3 permisos — ver CLAUDE.md, modo
    // desarrollador. Da acceso al panel de incidencias.
    function esDesarrollador() {
      return tienePermiso('desarrollador');
    }

    function esProfesorODireccion() {
      return esProfesor() || esDireccion();
    }

    function esPropioUsuario(uid) {
      return estaAutenticado() && request.auth.uid == uid;
    }

    // Generalización cross-curso (ver CLAUDE.md, permiso cruzado entre
    // cursos por nombre de asignatura): cualquier profesor que figure
    // en profesorIds de CUALQUIER asignatura que comparta nombre (vía
    // gruposAsignatura/{nombreNormalizado}, mantenido en cliente sin
    // Cloud Functions — ver DbService._sincronizarGrupoAsignatura)
    // puede gestionar notas/asistencia/matrículas de ESTA asignatura
    // concreta, sin depender de estar en profesorIds de este documento
    // en particular ni de un pin por alumno (matriculas.profesorId
    // pasa a ser puramente informativo). Sustituye a las antiguas
    // esProfesorDeAsignatura/esProfesorAsignadoAlAlumno.
    //
    // Usa .get(clave, default) en cada paso para fallar en `false`,
    // nunca lanzar un error de evaluación, si una asignatura todavía no
    // tiene nombreNormalizado (no migrada) o el grupo aún no existe —
    // mismo espíritu de "fallar cerrado sin excepción" que el chequeo
    // de resource == null (ver más abajo).
    function esProfesorDeAsignaturaPorNombre(asignaturaId) {
      let asig = get(/databases/$(database)/documents/asignaturas/$(asignaturaId)).data;
      return esProfesor() && asig.get('nombreNormalizado', '') != ''
          && request.auth.uid in
             get(/databases/$(database)/documents/gruposAsignatura/$(asig.nombreNormalizado)).data.get('profesorIds', []);
    }

    // Sustitución temporal: un profesor puede gestionar CUALQUIER
    // alumno de la asignatura para un día concreto si dirección le ha
    // dado de alta como sustituto ese día (ver colección sustituciones,
    // ID determinista `${asignaturaId}_${profesorId}_${fecha}`).
    function tieneSustitucion(asignaturaId, fecha) {
      return esProfesor() && exists(
          /databases/$(database)/documents/sustituciones/$(asignaturaId + '_' + request.auth.uid + '_' + fecha));
    }

    // Sesión de estudio SINTÉTICA generada por DbService al marcar
    // asistencia en una asignatura de instrumento (ver CLAUDE.md,
    // horaFin-horaInicio de la matrícula cuenta como horas de estudio):
    // quien la escribe es quien marca la asistencia (dirección,
    // profesor de la asignatura o sustituto ese día), no el alumno.
    // `fechaDia` denormalizado (mismo patrón que Nota.fechaDia) para
    // que tieneSustitucion() pueda comprobar sin parsear fechas.
    function esGeneradaPorAsistencia(data) {
      return data.get('origenAsistencia', false) == true
          && data.tipo == 'instrumento'
          && data.get('asignaturaId', null) is string
          && get(/databases/$(database)/documents/asignaturas/$(data.asignaturaId)).data.get('permiteGrabarEstudio', false) == true
          && (esDireccion()
              || esProfesorDeAsignaturaPorNombre(data.asignaturaId)
              || tieneSustitucion(data.asignaturaId, data.get('fechaDia', '')));
    }

    // ---------------------------------------------------------------
    // usuarios
    // Cada usuario lee/edita su propio documento (salvo permisos).
    // Profesor y dirección pueden leer cualquier perfil de alumno
    // para mostrar dashboards, historiales y notas.
    // Dirección puede crear cuentas de alumno de forma ágil (alta
    // rápida desde el panel de centro; ver AuthService.crearAlumno,
    // que usa una FirebaseApp secundaria para no cerrar su propia
    // sesión) y cambiar permisos o eliminar cuentas.
    // ---------------------------------------------------------------
    match /usuarios/{uid} {
      allow read: if esPropioUsuario(uid) || esProfesorODireccion();

      allow create: if (esPropioUsuario(uid) && request.resource.data.permisos == ['alumno'])
                    || esDireccion();

      allow update: if (esPropioUsuario(uid)
                        && request.resource.data.permisos == resource.data.permisos)
                    || esDireccion();

      allow delete: if esDireccion();
    }

    // ---------------------------------------------------------------
    // sesionesEstudio
    // El alumno crea/lee/edita SUS PROPIAS sesiones grabadas con
    // micrófono. Un profesor también puede CREAR/CORREGIR sesiones
    // tipo 'teorico' en nombre de un alumno (total MENSUAL anotado a
    // mano de un cuaderno, ver CLAUDE.md) para asignaturas NO
    // instrumentales — no puede reetiquetar alumno/asignatura/tipo. La
    // corrección posterior (update) la puede hacer CUALQUIER profesor
    // de esa asignatura (permiso cruzado por nombre, no solo quien la
    // creó — igual que el create), para que un compañero pueda
    // arreglar un total equivocado. Profesor y dirección: lectura de
    // cualquier alumno.
    // ---------------------------------------------------------------
    match /sesionesEstudio/{sesionId} {
      // La segunda condición de alumno (tipo in [instrumento, teorico])
      // es una excepción DELIBERADA para el Cuadro de Honor (ranking
      // global/por bloques de horas, visible también para alumnos con
      // nombres — a diferencia del ranking por asignatura, que sigue
      // siendo solo para profesor/dirección, ver CLAUDE.md puntos 14 y
      // 27). Sin Cloud Functions desplegadas, el cliente necesita poder
      // leer las sesiones de OTROS alumnos para agregarlas. Ampliado de
      // solo 'instrumento' a también 'teorico' para el ranking por
      // bloques de asignatura (ver CLAUDE.md) — abierto a TODAS las
      // sesiones teóricas sin condicionarlo a si la asignatura tiene
      // objetivo configurado: eso es una decisión de presentación, no
      // de seguridad.
      allow read: if (esAlumno() && resource.data.alumnoId == request.auth.uid)
                  || (esAlumno() && resource.data.tipo in ['instrumento', 'teorico'])
                  || esProfesorODireccion();

      // Dos formas de crear una sesión nueva (ya no existe la práctica
      // libre sin asignatura):
      // - El propio alumno graba con micrófono: debe apuntar a una
      //   asignatura que dirección haya marcado explícitamente con
      //   permiteGrabarEstudio == true (normalmente de instrumento).
      // - Un profesor anota a mano las horas semanales de un alumno en
      //   una asignatura NO instrumental (armonía, lenguaje musical...):
      //   tipo debe ser 'teorico' y el profesor debe pasar el permiso
      //   cruzado por nombre de asignatura (ver CLAUDE.md punto 51) —
      //   sin exigir permiteGrabarEstudio, que es justamente lo
      //   contrario de para qué es esta rama.
      // Las sesiones antiguas con asignaturaId == null (antes del punto
      // 41) no se tocan, esta condición solo aplica a creaciones nuevas.
      allow create: if (esAlumno()
                        && request.resource.data.alumnoId == request.auth.uid
                        && request.resource.data.get('asignaturaId', null) is string
                        && get(/databases/$(database)/documents/asignaturas/$(request.resource.data.asignaturaId)).data.get('permiteGrabarEstudio', false) == true)
                    || (esProfesor()
                        && request.resource.data.get('registradoPorProfesorId', '') == request.auth.uid
                        && request.resource.data.tipo == 'teorico'
                        && request.resource.data.get('asignaturaId', null) is string
                        && esProfesorDeAsignaturaPorNombre(request.resource.data.asignaturaId))
                    || esGeneradaPorAsistencia(request.resource.data);

      allow update: if (esAlumno()
                        && resource.data.alumnoId == request.auth.uid
                        && request.resource.data.duracionEfectivaMs == resource.data.duracionEfectivaMs
                        && request.resource.data.duracionTotalMs == resource.data.duracionTotalMs
                        && request.resource.data.asignaturaId == resource.data.asignaturaId)
                    || (esProfesor()
                        && resource.data.get('registradoPorProfesorId', '') != ''
                        && request.resource.data.alumnoId == resource.data.alumnoId
                        && request.resource.data.asignaturaId == resource.data.asignaturaId
                        && request.resource.data.tipo == resource.data.tipo
                        && request.resource.data.registradoPorProfesorId == request.auth.uid
                        && esProfesorDeAsignaturaPorNombre(resource.data.asignaturaId))
                    || (resource.data.get('origenAsistencia', false) == true
                        && request.resource.data.alumnoId == resource.data.alumnoId
                        && request.resource.data.asignaturaId == resource.data.asignaturaId
                        && esGeneradaPorAsistencia(request.resource.data));

      allow delete: if esDireccion()
                    || (resource.data.get('origenAsistencia', false) == true
                        && (esProfesorDeAsignaturaPorNombre(resource.data.asignaturaId)
                            || tieneSustitucion(resource.data.asignaturaId, resource.data.get('fechaDia', ''))));
    }

    // ---------------------------------------------------------------
    // modulos
    // Creados y editados por profesores (y dirección).
    // Lectura abierta a cualquier usuario autenticado (alumnos
    // necesitan verlos para completar ejercicios).
    // ---------------------------------------------------------------
    match /modulos/{moduloId} {
      allow read: if estaAutenticado();
      allow create, update, delete: if esProfesorODireccion();
    }

    // ---------------------------------------------------------------
    // ejercicios
    // Igual que módulos: gestión por profesor/dirección, lectura abierta.
    // ---------------------------------------------------------------
    match /ejercicios/{ejercicioId} {
      allow read: if estaAutenticado();
      allow create, update, delete: if esProfesorODireccion();
    }

    // ---------------------------------------------------------------
    // ejerciciosCompletados
    // El alumno marca sus propios ejercicios como completados.
    // Profesor/dirección: solo lectura.
    // ---------------------------------------------------------------
    match /ejerciciosCompletados/{registroId} {
      allow read: if esAlumno() && resource.data.alumnoId == request.auth.uid
                  || esProfesorODireccion();

      allow create: if esAlumno()
                    && request.resource.data.alumnoId == request.auth.uid;

      allow update, delete: if false; // registro inmutable una vez creado
    }

    // ---------------------------------------------------------------
    // notas
    // Cualquier profesor de la asignatura (de cualquier curso que
    // comparta nombre, ver esProfesorDeAsignaturaPorNombre — permiso
    // cruzado entre cursos, CLAUDE.md) crea notas, sin depender de un
    // pin por alumno; también con una sustitución activa ese día.
    // El alumno solo puede LEER las suyas propias.
    // Solo dirección puede cambiar el campo "estado" a "supervisada"
    // o "corregida" (flujo de supervisión).
    // ---------------------------------------------------------------
    match /notas/{notaId} {
      allow read: if esAlumno() && resource.data.alumnoId == request.auth.uid
                  || esProfesorODireccion();

      allow create: if esProfesor()
                    && request.resource.data.profesorId == request.auth.uid
                    && request.resource.data.estado == 'pendiente'
                    && request.resource.data.valor >= 0 && request.resource.data.valor <= 10
                    && (esProfesorDeAsignaturaPorNombre(request.resource.data.asignaturaId)
                        || tieneSustitucion(request.resource.data.asignaturaId, request.resource.data.fechaDia));

      allow update: if esDireccion()
                    || (esProfesor()
                        && resource.data.profesorId == request.auth.uid
                        && resource.data.estado == 'pendiente'
                        && request.resource.data.valor >= 0 && request.resource.data.valor <= 10);

      allow delete: if esDireccion();
    }

    // ---------------------------------------------------------------
    // estadisticasAlumno
    // Documento agregado, uno por alumno (doc id == alumnoId).
    // Solo se escribe desde Cloud Functions (trigger al crear sesión),
    // nunca directamente desde el cliente -> evita manipulación del
    // ranking. Lectura: el propio alumno, profesor, dirección.
    // ---------------------------------------------------------------
    match /estadisticasAlumno/{alumnoId} {
      allow read: if esPropioUsuario(alumnoId) || esProfesorODireccion();
      allow write: if false; // solo Cloud Functions con Admin SDK
    }

    // ---------------------------------------------------------------
    // configuracion
    // Documento único configuracion/centro con el curso escolar activo
    // (p.ej. "2026/2027") y el historial de cursos anteriores. Lectura
    // abierta (todas las pantallas necesitan saber qué curso está
    // activo para filtrar); solo dirección lo cambia. Nunca se borra.
    // ---------------------------------------------------------------
    match /configuracion/{docId} {
      allow read: if estaAutenticado();
      allow create, update: if esDireccion();
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // cursos
    // Control total de dirección (crear/editar/eliminar). Lectura
    // abierta a cualquier usuario autenticado, como modulos/ejercicios.
    // ---------------------------------------------------------------
    match /cursos/{cursoId} {
      allow read: if estaAutenticado();
      // get(..., 0) en vez de acceso directo: el objetivo de horas vivía
      // antes en asignaturas y se ha movido aquí (ver CLAUDE.md) — los
      // cursos creados antes de ese cambio no tienen el campo, y
      // acceder directo lanzaría un error de evaluación
      // (permission-denied) al editarlos por primera vez tras el cambio.
      allow create, update: if esDireccion()
                            && request.resource.data.get('horasObjetivoMensual', 0) >= 0;
      allow delete: if esDireccion();
    }

    // ---------------------------------------------------------------
    // asignaturas
    // Igual que cursos: solo dirección gestiona la estructura
    // (nombre, profesorIds). Profesor solo lee. El horario semanal
    // (diasSemana) va en la matrícula, no aquí (ver CLAUDE.md punto 7).
    // ---------------------------------------------------------------
    match /asignaturas/{asignaturaId} {
      allow read: if estaAutenticado();
      // get(..., 0) por si el documento es de antes de este campo (ver
      // CLAUDE.md, objetivo de horas por asignatura) — mismo criterio
      // que `cursos.horasObjetivoMensual` más arriba.
      allow create, update: if esDireccion()
                            && request.resource.data.get('horasObjetivoSemanal', 0) >= 0
                            && request.resource.data.get('horasObjetivoMensual', 0) >= 0;
      allow delete: if esDireccion();
    }

    // ---------------------------------------------------------------
    // gruposAsignatura
    // Agregado de profesorIds por nombre normalizado de asignatura
    // (across-curso), mantenido en cliente al crear/editar una
    // asignatura o (des)asignar un profesor (ver
    // DbService._sincronizarGrupoAsignatura, sin Cloud Functions).
    // Solo lo escribe dirección (vía ese código); lectura abierta,
    // la necesita esProfesorDeAsignaturaPorNombre() para cualquier
    // profesor.
    // ---------------------------------------------------------------
    match /gruposAsignatura/{nombreNormalizado} {
      allow read: if estaAutenticado();
      allow write: if esDireccion();
    }

    // ---------------------------------------------------------------
    // criteriosEvaluacion
    // Define, por asignatura, qué actividades/controles son
    // puntuables y qué peso (%) tienen en la nota final. Solo
    // dirección los crea/edita/elimina; lectura abierta (profesor los
    // necesita para poder elegir criterio al poner una nota, alumno
    // para ver a qué corresponde cada nota suya).
    // ---------------------------------------------------------------
    match /criteriosEvaluacion/{criterioId} {
      allow read: if estaAutenticado();
      allow create, update: if esDireccion()
                            && request.resource.data.peso >= 0 && request.resource.data.peso <= 100;
      allow delete: if esDireccion();
    }

    // ---------------------------------------------------------------
    // plusesOrquesta
    // Catálogo de pluses de horas por orquesta (p.ej. "Orquesta de
    // guitarras" suma horas/semana a "Guitarra"), gestionado por
    // dirección — se elige uno al matricular (ver
    // Matricula.plusOrquestaId). Lectura abierta: cualquier profesor
    // que edite una matrícula necesita ver el catálogo para elegir.
    // ---------------------------------------------------------------
    match /plusesOrquesta/{plusId} {
      allow read: if estaAutenticado();
      allow create, update: if esDireccion() && request.resource.data.horasSemana >= 0;
      allow delete: if esDireccion();
    }

    // ---------------------------------------------------------------
    // matriculas
    // Solo dirección matricula/desmatricula alumnos en asignaturas.
    // El alumno lee sus propias matrículas; el profesor lee las de
    // las asignaturas donde está asignado.
    // ---------------------------------------------------------------
    match /matriculas/{matriculaId} {
      // resource == null cuando el doc no existe (p.ej. get() por ID
      // determinista antes de matricular): sin ese chequeo, acceder a
      // resource.data más abajo lanza un error de evaluación, que
      // Firestore reporta como permission-denied en vez de "no existe".
      allow read: if esDireccion()
                  || (estaAutenticado() && resource == null)
                  || (esAlumno() && resource.data.alumnoId == request.auth.uid)
                  || esProfesorDeAsignaturaPorNombre(resource.data.asignaturaId);
      allow create, update, delete: if esDireccion();
    }

    // ---------------------------------------------------------------
    // asistencias
    // Marcada por cualquier profesor de la asignatura (cross-curso,
    // ver esProfesorDeAsignaturaPorNombre), con sustitución activa ese
    // día, o dirección. El alumno solo lee las suyas. En update no se
    // puede cambiar a qué alumno/asignatura/fecha corresponde el
    // registro (solo el valor asistio).
    // ---------------------------------------------------------------
    match /asistencias/{asistenciaId} {
      // resource == null: ver comentario en matriculas — el calendario
      // consulta días sin asistencia marcada todavía (caso normal).
      allow read: if esDireccion()
                  || (estaAutenticado() && resource == null)
                  || (esAlumno() && resource.data.alumnoId == request.auth.uid)
                  || esProfesorDeAsignaturaPorNombre(resource.data.asignaturaId);

      allow create: if esDireccion()
                    || esProfesorDeAsignaturaPorNombre(request.resource.data.asignaturaId)
                    || tieneSustitucion(request.resource.data.asignaturaId, request.resource.data.fecha);

      allow update: if esDireccion()
                    || ((esProfesorDeAsignaturaPorNombre(resource.data.asignaturaId)
                         || tieneSustitucion(resource.data.asignaturaId, resource.data.fecha))
                        && request.resource.data.alumnoId == resource.data.alumnoId
                        && request.resource.data.asignaturaId == resource.data.asignaturaId
                        && request.resource.data.fecha == resource.data.fecha
                        && request.resource.data.cursoEscolar == resource.data.cursoEscolar);

      allow delete: if esDireccion();
    }

    // ---------------------------------------------------------------
    // sustituciones
    // Concede a un profesor acceso temporal a TODOS los alumnos de una
    // asignatura para un día concreto (cubre bajas/sustituciones). Solo
    // dirección las crea/edita/elimina, desde la ficha de la asignatura.
    // ---------------------------------------------------------------
    match /sustituciones/{sustitucionId} {
      allow read: if estaAutenticado();
      allow create, update, delete: if esDireccion();
    }

    // ---------------------------------------------------------------
    // horariosLaborales
    // Horario semanal recurrente de UN trabajador (profesor o
    // dirección) para el registro de jornada (Art. 34.9 ET): el
    // propio trabajador lo configura (qué días trabaja y a qué hora),
    // dirección puede verlo/editarlo de todos para supervisión. Doc
    // id == uid del trabajador.
    // ---------------------------------------------------------------
    match /horariosLaborales/{empleadoId} {
      allow read: if esDireccion() || esPropioUsuario(empleadoId);
      allow create, update: if esDireccion()
                            || (esPropioUsuario(empleadoId) && esProfesorODireccion());
      allow delete: if esDireccion();
    }

    // ---------------------------------------------------------------
    // marcajes
    // Fichaje de entrada/salida (Art. 34.9 ET, RD-ley 8/2019): un doc
    // por trabajador y día (ID determinista `${empleadoId}_${fecha}`).
    // El propio trabajador ficha su entrada (create, con horaSalida a
    // null) y más tarde su salida (update, solo de null a un valor —
    // no puede reescribir una vez fichada, ni tocar horaEntrada). Solo
    // dirección puede corregir libremente (con auditoría vía
    // corregidoPor/corregidoEn en el cliente). No se permite borrar
    // NUNCA: la ley obliga a conservar el registro 4 años.
    // ---------------------------------------------------------------
    match /marcajes/{marcajeId} {
      // resource == null: caso normal la primera vez que se abre
      // "Fichar" en el día (todavía no existe el doc de hoy) — ver
      // mismo comentario en matriculas/asistencias.
      allow read: if esDireccion()
                  || (estaAutenticado() && resource == null)
                  || (esProfesorODireccion() && resource.data.empleadoId == request.auth.uid);

      // Dos formas de crear un marcaje propio: el fichaje normal del
      // día (horaSalida aún null) o el autoinforme de un olvido en un
      // día pasado sin ningún marcaje (entrada Y salida ya puestas,
      // pendienteValidacion true hasta que dirección lo revise — ver
      // CLAUDE.md).
      allow create: if esProfesorODireccion()
                    && request.resource.data.empleadoId == request.auth.uid
                    && (request.resource.data.horaSalida == null
                        || (request.resource.data.get('pendienteValidacion', false) == true
                            && request.resource.data.horaSalida != null));

      allow update: if esDireccion()
                    || (esProfesorODireccion()
                        && resource.data.empleadoId == request.auth.uid
                        && request.resource.data.empleadoId == resource.data.empleadoId
                        && request.resource.data.fecha == resource.data.fecha
                        && request.resource.data.horaEntrada == resource.data.horaEntrada
                        && resource.data.horaSalida == null
                        && request.resource.data.horaSalida != null);

      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // incidencias
    // Cualquier usuario autenticado puede crear un reporte (problema o
    // sugerencia) y leer/comentar SOLO los suyos. El desarrollador
    // (permiso `desarrollador`, cuenta única fijada manualmente por
    // consola — ver CLAUDE.md) puede leer y gestionar TODOS: cambiar
    // `estado` a resuelto/pendiente y añadir comentarios. Un autor
    // NUNCA puede resolver su propio ticket (no puede tocar `estado`),
    // solo comentar. `comentarios` es una lista embebida (no
    // subcolección, ver convención del resto de la app) — el
    // `size()` +0/+1 en `update` acota cada escritura a "sin cambios"
    // o "un comentario añadido"; no valida elemento a elemento que los
    // comentarios previos no se hayan alterado (Firestore rules no
    // tiene bucles/comparación de prefijos de lista) — mismo nivel de
    // confianza ya asumido hoy, sin guardas, para
    // `asignaturas.profesorIds` con arrayUnion.
    // ---------------------------------------------------------------
    match /incidencias/{incidenciaId} {
      allow read: if esDesarrollador()
                  || (estaAutenticado() && resource.data.autorId == request.auth.uid);

      allow create: if estaAutenticado()
                    && request.resource.data.autorId == request.auth.uid
                    && request.resource.data.tipo in ['problema', 'sugerencia']
                    && request.resource.data.estado == 'pendiente'
                    && request.resource.data.comentarios.size() == 0;

      allow update: if (esDesarrollador()
                        && request.resource.data.autorId == resource.data.autorId
                        && request.resource.data.autorNombre == resource.data.autorNombre
                        && request.resource.data.tipo == resource.data.tipo
                        && request.resource.data.descripcion == resource.data.descripcion
                        && request.resource.data.fecha == resource.data.fecha
                        && request.resource.data.estado in ['pendiente', 'resuelto']
                        && (request.resource.data.comentarios.size() == resource.data.comentarios.size()
                            || request.resource.data.comentarios.size() == resource.data.comentarios.size() + 1))
                    || (estaAutenticado()
                        && resource.data.autorId == request.auth.uid
                        && request.resource.data.autorId == resource.data.autorId
                        && request.resource.data.autorNombre == resource.data.autorNombre
                        && request.resource.data.tipo == resource.data.tipo
                        && request.resource.data.descripcion == resource.data.descripcion
                        && request.resource.data.fecha == resource.data.fecha
                        && request.resource.data.estado == resource.data.estado
                        && request.resource.data.comentarios.size() == resource.data.comentarios.size() + 1);

      allow delete: if esDesarrollador();
    }
  }
}
